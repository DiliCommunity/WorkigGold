# Локально можно использовать DATABASE_URL и POSTGRES_URL = одно и то же
DATABASE_URL="postgresql://user:password@localhost:5432/workinggold"
PRISMA_DATABASE_URL="postgresql://user:password@localhost:5432/workinggold"
POSTGRES_URL="postgresql://user:password@localhost:5432/workinggold"

TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="123456789"
TELEGRAM_CHANNEL_URL="https://t.me/your_channel"
TELEGRAM_WEBHOOK_SECRET="your_webhook_secret"
OPENAI_API_KEY="your_openai_api_key"
# Опционально для ИИ-бухгалтера: модель OpenAI
# OPENAI_MODEL="gpt-4o-mini"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Бюджет на отклики и подписки (₽), страница /accountant
ACCOUNTANT_BUDGET_RUB=10000
# Курс для парсинга Guru (USD → ₽), опционально
# ACCOUNTANT_USD_RUB=100

# Опционально: публичные Telegram-каналы (юзернеймы без @), через запятую
# TELEGRAM_CHANNELS="freelance_channel,it_jobs"

# Опционально: VK — сервисный ключ приложения и короткие имена групп (domain), через запятую
# VK_SERVICE_TOKEN=""
# VK_GROUPS="freelance_group,it_vacancies"

# Опционально: Reddit — сабреддиты через запятую (ищем посты с [Hiring])
# REDDIT_SUBS="forhire,freelance_forhire"

# Kwork — мобильное API (логин как на сайте). Не коммитьте реальные значения.
KWORK_LOGIN=""
KWORK_PASSWORD=""
# Если при входе Kwork просит подтверждение (код 192) — последние цифры телефона:
# KWORK_PHONE_LAST="12"

# === Резюме для автоотклика (кнопка "Отправить отклик" на объявлениях) ===
RESUME_NAME="Ваше имя или ник"
RESUME_SKILLS="React, TypeScript, Node.js, PostgreSQL, API"
RESUME_EXPERIENCE="5+ лет коммерческой разработки. Веб-приложения, бэкенд, парсеры."
RESUME_PORTFOLIO_URL="https://github.com/username"
RESUME_EMAIL="your@email.com"
RESUME_PHONE="+7 999 123-45-67"
# Опционально: свой текст приветствия (иначе будет шаблон с названием проекта)
# RESUME_INTRO="Добрый день! Готов взяться за ваш проект."

# === Чат CRM + идентификаторы аккаунтов на биржах (пароли не коммитьте) ===
# Имя в шапке чатов; если пусто — подставится RESUME_NAME
CHAT_DISPLAY_NAME=""
# Логин/email на биржах (для будущей синхронизации; сейчас — подсказка в интерфейсе)
FL_RU_LOGIN=""
FREELANCE_RU_LOGIN=""
GURU_LOGIN=""
# Kwork: пароль уже в KWORK_PASSWORD; логин — KWORK_LOGIN
